{
  "name": "graphql-forbidden",
  "priority": 1,
  "request": {"method": "POST", "urlPath": "/graphql", "bodyPatterns": [
    {"matchesJsonPath": {"expression": "$.operationName", "equalTo": "Account"}},
    {"matchesJsonPath": {"expression": "$.variables.id", "equalTo": "denied"}}
  ]},
  "response": {"status": 200, "headers": {"Content-Type": "application/json"}, "jsonBody": {"data": {"account": null}, "errors": [{"message": "Forbidden", "path": ["account"], "extensions": {"code": "FORBIDDEN"}}]}}
}
